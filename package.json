    "opencode",
    "opencode-plugin",
    "composio",
    "gmail",
    "calendar",
    "slack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaygupta17/opencode-composio.git"
  },
  "homepage": "https://github.com/jaygupta17/opencode-composio#readme",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./permissions.json": "./permissions.json"
  },
  "files": [
    "index.ts",
    "src",
    "permissions.json"
  ],
  "scripts": {
    "catalog": "bun scripts/catalog.ts && bun scripts/permissions.ts",
    "permissions": "bun scripts/permissions.ts",
